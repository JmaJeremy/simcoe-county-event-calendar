{
  "$schema": "node_modules/wrangler/config-schema.json",
  "name": "scec-ingest",
  "main": "src/worker.ts",
  "compatibility_date": "2026-09-01",
  "compatibility_flags": ["nodejs_compat"],
  "observability": { "enabled": true },
  // Keeps scec-ingest.thejeremy-net.workers.dev, which /run is called on. Declaring routes
  // below turns the workers.dev URL off unless this says otherwise.
  "workers_dev": true,
  // The admin console. Cloudflare Access (application "outinsimcoe.ca console") guards
  // this hostname, and the worker verifies the Access token itself as well: the same code
  // answers on workers.dev, which Access does not cover. See src/access.ts.
  "routes": [{ "pattern": "console.outinsimcoe.ca", "custom_domain": true }],
  // CONSOLE_HOST, ACCESS_TEAM_DOMAIN, ACCESS_AUD and PUBLIC_ORIGIN are worker secrets, not
  // vars: set them with `wrangler secret put` (see CLAUDE.md). ACCESS_TEAM_DOMAIN is the full
  // URL, https://jerail.cloudflareaccess.com.
  // Posters uploaded with suggestions, read by the console to show them behind Access.
  // The web worker writes them.
  "r2_buckets": [{ "binding": "POSTERS", "bucket_name": "scec-suggestion-posters" }],
  // Cloudflare Email Service, for the console to tell a suggester their suggestion was
  // accepted. The web worker has its own binding for the form's two emails.
  "send_email": [{ "name": "EMAIL" }],
  "triggers": {
    // Every two hours: community calendars change on the order of days, and several of
    // the sources are third-party servers we would rather not lean on.
    "crons": ["23 */2 * * *"]
  },
  "d1_databases": [
    {
      "binding": "DB",
      "database_name": "scec",
      "database_id": "2a5bb740-6719-4498-9c0d-4f8eb7b601b9",
      "migrations_dir": "migrations"
    }
  ]
}
