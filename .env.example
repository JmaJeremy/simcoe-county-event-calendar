# Cloudflare credentials used by wrangler for deploys. Copy to .env and fill in.
# Never commit the real file.
CLOUDFLARE_ACCOUNT_ID=
CLOUDFLARE_API_TOKEN=
# Shared secret for the ingest worker's manual POST /run trigger.
INGEST_TOKEN=
# Claude API key for the de-duplication judge (also set as a Worker secret).
ANTHROPIC_API_KEY=

# Ticketing sources, also Worker secrets on scec-ingest. Eventbrite: a personal OAuth token
# (eventbrite.com/platform/api-keys). Ticketmaster: the Discovery API consumer key; the
# consumer secret is for OAuth flows the ingest never makes, so it is not needed anywhere.
EVENTBRITE_TOKEN=
TICKETMASTER_CONSUMER_KEY=

# The Canadian fetch proxy: an AWS Lambda in ca-central-1 that fetches the municipal
# calendars refusing requests from outside Canada. Also Worker secrets on scec-ingest. The
# access key belongs to an IAM user that may do nothing but invoke that one function.
# FETCH_PROXY_FORCE=1 sends every GET through it, for testing the path from a machine
# nobody blocks.
FETCH_PROXY_FUNCTION=scec-ca-fetch-proxy
FETCH_PROXY_REGION=ca-central-1
FETCH_PROXY_ACCESS_KEY_ID=
FETCH_PROXY_SECRET_ACCESS_KEY=

# Cloudflare Turnstile on the suggestion form. The site key is public and is also
# hardcoded in apps/web/public/suggest.js; the secret goes on the web worker with
# `wrangler secret put TURNSTILE_SECRET_KEY`. Without it the form refuses everything.
TURNSTILE_SITE_KEY=
TURNSTILE_SECRET_KEY=

# The password pepper for user accounts: a Worker secret on scec-web, HMAC'd over every
# password before PBKDF2 (see apps/web/src/auth/password.ts). Stored in no database, which
# is the point — generate 32+ random bytes once and never rotate casually: rotating it
# invalidates every stored password at a stroke.
PASSWORD_PEPPER=

# Google sign-in (all three or the button is not rendered and its routes answer 404).
# The client id is public; the secret comes from the same OAuth client in Google Cloud
# console — type "Web application", with the callback /account/google/callback registered
# on the apex, on scec-web-dev's workers.dev host, and on localhost:8788 for dev.
GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=
# Signs the OAuth round-trip cookie (state, nonce, PKCE verifier). Its own secret, so
# rotating it only aborts in-flight sign-ins; 32+ random bytes.
OAUTH_STATE_KEY=
# Signs each reader's private calendar feed URL (/calendar/{id}.{mac}.ics) and every
# digest's unsubscribe link (/unsubscribe/{id}.{mac}). With it and a copy of scec-accounts
# anyone's feed could be opened, so it is a secret; rotating it replaces every private feed
# link and breaks unsubscribe links in digests already sent. Unset, private feeds are off
# and no digest is sent. 32+ random bytes.
FEED_TOKEN_KEY=
