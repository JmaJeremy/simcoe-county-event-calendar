# Cloudflare credentials used by wrangler for deploys. Copy to .env and fill in.
# Never commit the real file.
CLOUDFLARE_ACCOUNT_ID=
CLOUDFLARE_API_TOKEN=
# Shared secret for the ingest worker's manual POST /run trigger.
INGEST_TOKEN=
# Claude API key for the de-duplication judge (also set as a Worker secret).
ANTHROPIC_API_KEY=

# Cloudflare Turnstile on the suggestion form. The site key is public and is also
# hardcoded in apps/web/public/suggest.js; the secret goes on the web worker with
# `wrangler secret put TURNSTILE_SECRET_KEY`. Without it the form refuses everything.
TURNSTILE_SITE_KEY=
TURNSTILE_SECRET_KEY=
